# backend/src/main/resources/application-local.yml-example
# Copy this file to application-local.yml and fill in your real values.
# application-local.yml is gitignored and should never be committed.

spring:
  datasource:
    username: your_db_username
    password: your_db_password

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: your_google_client_id
            client-secret: your_google_client_secret

jwt:
  secret: replace_with_a_random_secret_min_32_chars
  expiration: 604800000
  refresh-expiration: 2592000000