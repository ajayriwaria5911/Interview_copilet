# ---- Java / Maven ----
HELP.md
target/
*.class
*.jar
*.war
*.ear
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar

# ---- Spring Boot ----
**/application-local.yml
application-local.yml

# ---- IDE — STS ----
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ---- IDE — IntelliJ ----
.idea
*.iws
*.iml
*.ipr

# ---- IDE — NetBeans ----
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ---- IDE — VS Code ----
.vscode/

# ---- Environment files — NEVER commit ----
.env
.env.local
**/.env
**/.env.local

# ---- Startup scripts — NEVER commit ----
**/start.ps1
**/start.sh
start.ps1
start.sh

# ---- Node / Frontend ----
node_modules/
dist/
build/
.next/
.nuxt/

# ---- Python / AI Service ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
.pytest_cache/

# ---- Logs ----
*.log
logs/
**/logs/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker volumes ----
docker/volumes/

# ---- Upload files ----
uploads/
**/uploads/